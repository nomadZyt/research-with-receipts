# Leave Inference values empty for the D2 local path.
# The stub planner runs when the API key is blank. Never commit a real key.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Model id is read only after the API key is set. Leave empty for D2.
VULTR_INFERENCE_MODEL=
VULTR_API_KEY=
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_SHM_SIZE=256m
SANDBOX_IMAGE=research-with-receipts-sandbox:latest
SANDBOX_NETWORK=bridge
# Absolute host path of var/sandbox-jobs, only if the orchestrator runs in
# Docker and mount detection fails. Leave empty for host uvicorn and Compose.
HOST_SANDBOX_JOBS_DIR=
SANDBOX_JOBS_DIR=
SCREENSHOTS_DIR=
PORT=8080
